# Copy to deploy/graph-node/.env and restrict it to the server administrator.
GRAPH_POSTGRES_PASSWORD=replace-with-a-long-random-password
HEDERA_EVM_RPC_URL=https://testnet.hashio.io/api
GRAPH_LOG=info

# All Graph Node ports remain bound to server loopback.
GRAPH_IPFS_API_PORT=5001
GRAPH_QUERY_PORT=8000
GRAPH_WS_PORT=8001
GRAPH_ADMIN_PORT=8020
GRAPH_STATUS_PORT=8030
GRAPH_METRICS_PORT=8040
