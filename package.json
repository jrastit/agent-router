{
  "name": "agent-router",
  "version": "0.1.0",
  "private": true,
  "exports": {
    "./toolkit": "./src/toolkit/index.ts",
    "./toolkit/compute/server": "./src/toolkit/compute/0g-router-server.ts",
    "./toolkit/storage/server": "./src/toolkit/storage/0g-server.ts",
    "./toolkit/provenance/server": "./src/toolkit/provenance/0g-chain-server.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "pm2:start": "pm2 start ecosystem.config.cjs",
    "pm2:reload": "pm2 reload ecosystem.config.cjs --update-env",
    "pm2:save": "pm2 save",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "graph:codegen": "graph codegen -o graph/app-events/generated graph/app-events/subgraph.yaml",
    "graph:build": "graph build graph/app-events/subgraph.yaml",
    "graph:projection:codegen": "graph codegen -o graph/hedera-projection/generated graph/hedera-projection/subgraph.yaml",
    "graph:projection:build": "graph build graph/hedera-projection/subgraph.yaml",
    "verify:client-secrets": "node --env-file-if-exists=.env scripts/verify-client-bundle-secrets.mjs",
    "validate:supabase": "bash scripts/validate-supabase.sh",
    "deploy:supabase": "node --env-file=.env scripts/deploy-supabase-migrations.mjs",
    "reconcile:deposits": "tsx --env-file=.env scripts/reconcile-submitted-deposits.ts --confirm-production-reconciliation",
    "worker:deposit-projection": "tsx --env-file=.env scripts/run-deposit-projection-worker.ts",
    "validate:hedera-subgraph": "node --env-file=.env scripts/validate-hedera-subgraph.mjs",
    "deploy:hedera-app-events": "node --env-file=.env scripts/deploy-hedera-app-events.mjs --confirm-live-testnet",
    "deploy:hedera-app-events:sdk": "node --env-file=.env scripts/deploy-hedera-app-events-sdk.mjs --confirm-live-testnet",
    "emit:hedera-app-event": "node --env-file=.env scripts/emit-hedera-app-event.mjs --confirm-live-testnet",
    "emit:hedera-economic-event": "node --env-file=.env scripts/emit-hedera-economic-event.mjs --confirm-live-testnet",
    "deploy:hedera-subgraph": "node --env-file=.env scripts/deploy-hedera-subgraph.mjs --confirm-private-graph-node",
    "deploy:hedera-projection-subgraph:local": "node --env-file=.env scripts/deploy-hedera-projection-subgraph.mjs --confirm-local-graph-node",
    "demo:hedera-projection:local": "node --no-warnings --env-file=.env scripts/run-hedera-projection-local.ts --confirm-local-projection",
    "demo:hedera": "node --env-file=.env scripts/run-hedera-phase6.mjs --confirm-live-testnet",
    "evm:local": "node scripts/run-local-ganache.mjs",
    "deploy:hedera-anchor:local": "node --env-file=.env scripts/deploy-hedera-anchor-local.mjs --confirm-local-ganache",
    "deploy:0g-provenance": "node --env-file=.env scripts/deploy-0g-provenance.mjs --confirm-live-testnet",
    "deploy:0g-provenance:mainnet": "node --env-file=.env scripts/deploy-0g-provenance.mjs --confirm-live-mainnet",
    "verify:0g-provenance": "node --env-file=.env scripts/verify-0g-provenance.mjs",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run graph:build && npm run graph:projection:build && npm run build && npm run verify:client-secrets"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "^1.2.10",
    "@ai-sdk/openai-compatible": "^3.0.14",
    "@hashgraph/hedera-wallet-connect": "^2.1.3",
    "@hashgraph/sdk": "^2.81.0",
    "@hiero-ledger/sdk": "^2.79.0",
    "@reown/appkit": "^1.8.10",
    "@reown/walletkit": "^1.2.8",
    "@supabase/supabase-js": "^2.110.8",
    "@walletconnect/modal": "^2.7.0",
    "@walletconnect/universal-provider": "^2.21.10",
    "ai": "^7.0.37",
    "ethers": "^6.13.1",
    "next": "16.2.11",
    "pm2": "^6.0.14",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "viem": "^2.38.6",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@graphprotocol/graph-cli": "^0.98.1",
    "@graphprotocol/graph-ts": "^0.38.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "ganache": "^7.9.2",
    "prettier": "3.9.6",
    "solc": "^0.8.36",
    "supabase": "2.109.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
